cicada 2

fx drive drive {
  shape = soft
  gain = 9dB
  tone = 9kHz
  mix = 0.7
}

fx delay delay {
  time = 1/8T
  feedback = 0.35
  damp = 6kHz
  pingpong = true
  width = 1
  mix = 1
}

fx reverb reverb {
  size = 1
  decay = 2.4s
  damp = 8kHz
  highpass = 120Hz
  predelay = 25ms
  mix = 1
}

fx comp comp {
  detect = peak
  threshold = -24dB
  ratio = 4
  knee = 6dB
  attack = 5ms
  release = 150ms
  makeup = 0dB
  mix = 1
}

title "Standard fx"

tempo 128

key a minor

seed 4242

track bass acid { cutoff = 620Hz insert = drive send delay = 0.3 send reverb = 0.35 }

track beat drums { send reverb = 0.2 }

pattern melody {
  gate = 55%
  1^ . 3 . 5~ 1 . 7,
}

pattern beat drums {
  bd: X... x... X... x...
  sd: .... X... .... X...
  ch: x.x. x.x. x.x. x.x.
  oh: .... .... ..x. ....
}

scene first {
  bass = melody
  beat = beat
}

scene second {
  bass = keep
  beat = keep
  delay.feedback = 0.4
}

song {
  first
  second
}

bus music {
  insert = comp
}
