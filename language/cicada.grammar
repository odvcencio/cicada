grammar cicada
extras = [ /[ \t\r\n]+/, comment ]
word = identifier

rule source_file = seq("cicada", integer, repeat(_declaration))
rule _declaration = choice(title_decl, tempo_decl, key_decl, seed_decl, instrument_decl, kit_decl, track_decl, phrase_decl, acid_pattern, note_pattern, drum_pattern, scene_decl, song_decl, fx_decl)
rule title_decl = seq("title", string)
rule tempo_decl = seq("tempo", number)
rule key_decl = seq("key", key_root, identifier)
rule seed_decl = seq("seed", integer)
rule track_decl = seq("track", field("name", identifier), field("kind", identifier), "{", repeat(param_decl), "}")
rule instrument_decl = seq("instrument", field("name", identifier), "{", repeat(instrument_param), voice_decl, "}")
rule kit_decl = seq("kit", field("name", identifier), "{", repeat(kit_binding), "}")
rule kit_binding = seq(field("lane", identifier), "=", field("target", kit_target), ";")
rule kit_target = choice(identifier, seq("builtin", ".", identifier))
rule instrument_param = seq("param", field("name", identifier), ":", field("unit", identifier), "=", field("default", number), ";")
rule voice_decl = seq("voice", field("mode", identifier), "{", repeat(let_stmt), out_stmt, "}")
rule let_stmt = seq("let", field("name", identifier), "=", field("value", expression), ";")
rule out_stmt = seq("out", "=", field("value", expression), ";")
rule expression = choice(prec.left(1, seq(field("left", expression), choice("+", "-"), field("right", expression))), prec.left(2, seq(field("left", expression), choice("*", "/"), field("right", expression))), call_expr, number, identifier, seq("(", expression, ")"))
rule call_expr = seq(field("function", identifier), "(", optional(seq(expression, repeat(seq(",", expression)))), ")")
rule param_decl = seq(field("name", identifier), "=", field("value", value))
rule fx_decl = seq("fx", field("name", identifier), "{", repeat(param_decl), "}")
rule phrase_decl = seq("phrase", field("name", identifier), "acid", "{", repeat(acid_step), "}")
rule acid_pattern = seq("pattern", field("name", identifier), "acid", repeat(pattern_attr), "{", repeat(choice(acid_step, phrase_use)), "}")
rule note_pattern = seq("pattern", field("name", identifier), "notes", repeat(pattern_attr), "{", repeat(choice(acid_step, phrase_use)), "}")
rule phrase_use = seq("use", field("name", identifier), optional(seq("*", integer)), optional(seq("transpose", "=", number)))
rule drum_pattern = seq("pattern", field("name", identifier), "drums", repeat(pattern_attr), "{", repeat(drum_lane), "}")
rule pattern_attr = seq(field("name", identifier), "=", field("value", number))
rule acid_step = choice(".", "-", "|", acid_note)
rule acid_note = seq(field("pitch", pitch), repeat(octave_shift), repeat(modifier))
rule pitch = choice(degree, letter_pitch)
rule degree = token(/[1-7][#b]?/)
rule letter_pitch = token(/[a-g][#b]?[0-6]?/)
rule octave_shift = choice("'", ",")
rule modifier = choice("^", "~", ratchet, probability)
rule drum_lane = seq(field("name", identifier), ":", repeat(drum_hit), ";")
rule drum_hit = seq(choice(".", "x", "X", velocity_hit), optional(ratchet), optional(probability))
rule velocity_hit = token(/x[1-9]/)
rule ratchet = seq("*", integer)
rule probability = seq("%", integer)
rule scene_decl = seq("scene", field("name", identifier), "{", repeat(scene_assignment), "}")
rule scene_assignment = seq(field("track", identifier), "=", field("pattern", identifier))
rule song_decl = seq("song", "{", repeat(song_entry), "}")
rule song_entry = seq(field("scene", identifier), optional(seq("*", integer)))
rule value = choice(fraction, number, identifier, string)
rule fraction = token(/[0-9]+\/[0-9]+(T|\.)?/)
rule number = token(/-?[0-9]+(\.[0-9]+)?(hz|khz|ms|s|db|%)?/)
rule integer = token(/[0-9]+/)
rule key_root = token(/[a-g][#b]?/)
rule string = token(/"([^"\\]|\\.)*"/)
rule identifier = token(/[a-z_][a-z0-9_-]*/)
rule comment = token(/\/\/[^\n]*/)
