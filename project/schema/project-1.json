{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m31labs.dev/cicada/schema/project-1.json",
  "title": "Cicada semantic project v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "title", "tempo_milli", "key", "seed", "instruments", "kits", "tracks", "patterns", "scenes", "song", "effects"],
  "properties": {
    "format": {"const": "cicada.project/1"},
    "version": {"const": 1},
    "title": {"type": "string", "maxLength": 120},
    "tempo_milli": {"type": "integer", "minimum": 20000, "maximum": 300000},
    "key": {"$ref": "#/$defs/key"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "instruments": {"type": "array", "items": {"$ref": "#/$defs/instrument"}},
    "kits": {"type": "array", "items": {"$ref": "#/$defs/kit"}},
    "tracks": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/track"}},
    "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}},
    "scenes": {"type": "array", "items": {"$ref": "#/$defs/scene"}},
    "song": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/song_entry"}},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,63}$"},
    "key": {
      "type": "object", "additionalProperties": false, "required": ["root", "scale"],
      "properties": {
        "root": {"type": "integer", "minimum": 0, "maximum": 11},
        "scale": {"enum": ["minor", "major", "dorian", "phrygian", "harmonic", "pent", "mixo", "blues"]}
      }
    },
    "expr": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["literal"],
          "properties": {"literal": {"type": "number"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["name"],
          "properties": {"name": {"$ref": "#/$defs/id"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "args"],
          "properties": {
            "op": {"type": "string"},
            "args": {"type": "array", "items": {"$ref": "#/$defs/expr"}}
          }
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["unit", "number"],
          "properties": {
            "unit": {"enum": ["unit", "hz", "ms", "db"]},
            "number": {"type": "number"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["unit", "text"],
          "properties": {
            "unit": {"const": "enum"},
            "text": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "instrument_param": {
      "type": "object", "additionalProperties": false, "required": ["id", "unit", "default"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "unit": {"enum": ["unit", "hz", "ms", "db"]},
        "default": {"type": "number"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["id", "value"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/expr"}}
    },
    "instrument": {
      "type": "object", "additionalProperties": false, "required": ["id", "mode", "params", "lets", "out"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "mode": {"const": "mono"},
        "params": {"type": "array", "items": {"$ref": "#/$defs/instrument_param"}},
        "lets": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
        "out": {"$ref": "#/$defs/expr"}
      }
    },
    "kit": {
      "type": "object", "additionalProperties": false, "required": ["id", "lanes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "lanes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/id"}}
      }
    },
    "mixer": {
      "type": "object", "additionalProperties": false,
      "required": ["gain_db", "pan", "send_a", "send_b", "send_pre", "mute", "solo", "insert", "bus"],
      "properties": {
        "gain_db": {"type": "number", "minimum": -60, "maximum": 6},
        "pan": {"type": "number", "minimum": -1, "maximum": 1},
        "send_a": {"const": 0}, "send_b": {"const": 0},
        "send_pre": {"const": false}, "mute": {"type": "boolean"},
        "solo": {"const": false}, "insert": {"const": "none"}, "bus": {"const": "music"}
      }
    },
    "track": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "params", "mixer", "slots"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"},
        "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}},
        "mixer": {"$ref": "#/$defs/mixer"},
        "slots": {"type": "array", "minItems": 16, "maxItems": 16,
          "items": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["note", "accent", "slide", "tie", "ratchet", "probability", "velocity"],
      "properties": {
        "note": {"type": "integer", "minimum": 0, "maximum": 127},
        "accent": {"type": "boolean"}, "slide": {"type": "boolean"}, "tie": {"type": "boolean"},
        "ratchet": {"type": "integer", "minimum": 1, "maximum": 8},
        "probability": {"type": "integer", "minimum": 0, "maximum": 100},
        "velocity": {"type": "integer", "minimum": 0, "maximum": 127}
      }
    },
    "cell": {"oneOf": [{"$ref": "#/$defs/step"}, {"type": "null"}]},
    "lane_map": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "bd": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "sd": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "ch": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "oh": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "cp": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "rs": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "lt": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "mt": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "ht": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "cb": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "cy": {"type": "array", "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "pattern": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "steps", "swing_percent100", "gate_percent", "transpose", "seed", "data", "lanes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["acid", "notes", "drums"]},
        "steps": {"type": "integer", "minimum": 1, "maximum": 64},
        "swing_percent100": {"type": "integer", "minimum": 5000, "maximum": 7500},
        "gate_percent": {"type": "integer", "minimum": 10, "maximum": 100},
        "transpose": {"type": "integer", "minimum": -24, "maximum": 24},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "data": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/cell"}},
        "lanes": {"$ref": "#/$defs/lane_map"}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["id", "bindings"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "bindings": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "song_entry": {
      "type": "object", "additionalProperties": false, "required": ["scene", "bars"],
      "properties": {
        "scene": {"$ref": "#/$defs/id"},
        "bars": {"type": "integer", "minimum": 1, "maximum": 999}
      }
    },
    "effect": {
      "type": "object", "additionalProperties": false, "required": ["id", "params"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/value"}}
      }
    }
  }
}
