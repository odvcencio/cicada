                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "number"
                  ],
                  "properties": {
                    "unit": {
                      "const": "db"
                    },
                    "number": {
                      "type": "number",
                      "minimum": -24,
                      "maximum": 24
                    }
                  }
                }
              ]
            },
            "sidechain": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "text"
              ],
              "properties": {
                "unit": {
                  "const": "enum"
                },
                "text": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "mix": {
              "type": "object",
              "additionalProperties": false,
              "required": [
