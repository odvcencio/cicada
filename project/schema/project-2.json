              "type": "string"
            },
            "number": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "text"
          ],
          "properties": {
            "unit": {
              "const": "enum"
