{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m31labs.dev/cicada/schema/project-2.json",
  "title": "Cicada semantic project v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "title",
    "tempo_milli",
    "key",
    "seed",
    "instruments",
    "kits",
    "tracks",
    "patterns",
    "scenes",
    "song",
    "effects"
  ],
  "properties": {
    "format": {
      "const": "cicada.project/2"
    },
    "version": {
      "const": 2
    },
    "edition": {
      "enum": [
        1,
        2
      ],
      "description": "Source language edition; absent in legacy project JSON means 1"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "tempo_milli": {
      "type": "integer",
      "minimum": 20000,
      "maximum": 300000
    },
    "key": {
      "$ref": "#/$defs/key"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instrument"
      }
    },
    "kits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kit"
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "song": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/song_entry"
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "buses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bus"
      }
    },
    "master": {
      "$ref": "#/$defs/master"
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/export"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clip"
      }
    },
    "samplers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sampler"
      }
    },
    "live": {
      "$ref": "#/$defs/live"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]*(\\.[a-z_][a-z0-9_-]*)*$", "maxLength": 64
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "scale"
      ],
      "properties": {
        "root": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "scale": {
          "enum": [
            "minor",
            "major",
            "dorian",
            "phrygian",
            "harmonic",
            "pent",
            "mixo",
            "blues"
          ]
        }
      }
    },
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "number"
          ],
          "properties": {
            "unit": {
              "enum": [
                "unit",
                "ratio",
                "hz",
                "ms",
                "db",
                "lu",
                "lufs",
                "dbtp"
              ]
            },
            "number": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "text"
          ],
          "properties": {
            "unit": {
              "const": "enum"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "instrument_param": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "default"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "enum": [
            "unit",
            "hz",
            "ms",
            "db"
          ]
        },
        "default": {
          "type": "number"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "params",
        "lets",
        "out"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "octave": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "mode": {
          "enum": ["mono", "poly"]
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/instrument_param"
          }
        },
        "lets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "out": {
          "$ref": "#/$defs/expr"
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lanes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lanes": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "bd",
              "sd",
              "ch",
              "oh",
              "cp",
              "rs",
              "lt",
              "mt",
              "ht",
              "cb",
              "cy"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]*(\\.[a-z_][a-z0-9_-]*)*$", "maxLength": 64
          }
        }
      }
    },
    "mixer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/value"
        },
        "pan": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        },
        "inserts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mixer_send"
          }
        },
        "out": {
          "enum": [
            "music",
            "sfx"
          ]
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "params",
        "mixer",
        "slots"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/id"
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "mixer": {
          "$ref": "#/$defs/mixer"
        },
        "slots": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/id"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "note",
        "accent",
        "slide",
        "tie",
        "ratchet",
        "probability",
        "velocity"
      ],
      "properties": {
        "note": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "notes": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 127}},
        "accent": {
          "type": "boolean"
        },
        "slide": {
          "type": "boolean"
        },
        "tie": {
          "type": "boolean"
        },
        "ratchet": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "probability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "velocity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    },
    "cell": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "type": "null"
        }
      ]
    },
    "lane_map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bd": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "sd": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "ch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "oh": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "cp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "rs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "lt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "mt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "ht": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "cb": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "cy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "steps",
        "swing_percent100",
        "gate_percent",
        "transpose",
        "seed",
        "data",
        "lanes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "acid",
            "notes",
            "drums"
          ]
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "swing_percent100": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 7500
        },
        "gate_percent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        },
        "transpose": {
          "type": "integer",
          "minimum": -24,
          "maximum": 24
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "data": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        "lanes": {
          "$ref": "#/$defs/lane_map"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bindings"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene_setting"
          }
        }
      }
    },
    "song_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "bars"
      ],
      "properties": {
        "scene": {
          "$ref": "#/$defs/id"
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        }
      }
    },
    "drive_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "params"
      ],
      "properties": {
        "id": {
          "const": "drive"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "text"
              ],
              "properties": {
                "unit": {
                  "const": "enum"
                },
                "text": {
                  "enum": [
                    "soft",
                    "hard",
                    "fold",
                    "diode"
                  ]
                }
              }
            },
            "gain": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "db"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 36
                }
              }
            },
            "tone": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "hz"
                },
                "number": {
                  "type": "number",
                  "minimum": 1000,
                  "maximum": 20000
                }
              }
            },
            "mix": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "unit"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "delay_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "params"
      ],
      "properties": {
        "id": {
          "const": "delay"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "text"
                  ],
                  "properties": {
                    "unit": {
                      "const": "enum"
                    },
                    "text": {
                      "enum": [
                        "1/32",
                        "1/16",
                        "1/16T",
                        "1/16.",
                        "1/8",
                        "1/8T",
                        "1/8.",
                        "3/16",
                        "1/4",
                        "1/4.",
                        "1/2"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "number"
                  ],
                  "properties": {
                    "unit": {
                      "const": "ms"
                    },
                    "number": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 2000
                    }
                  }
                }
              ]
            },
            "feedback": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "unit"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.95
                }
              }
            },
            "damp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "hz"
                },
                "number": {
                  "type": "number",
                  "minimum": 1000,
                  "maximum": 16000
                }
              }
            },
            "pingpong": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "text"
              ],
              "properties": {
                "unit": {
                  "const": "enum"
                },
                "text": {
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "width": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "unit"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "mix": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "unit"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "reverb_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "params"
      ],
      "properties": {
        "id": {
          "const": "reverb"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "unit"
                },
                "number": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 1.5
                }
              }
            },
            "decay": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "ms"
                },
                "number": {
                  "type": "number",
                  "minimum": 300,
                  "maximum": 12000
                }
              }
            },
            "damp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "hz"
                },
                "number": {
                  "type": "number",
                  "minimum": 2000,
                  "maximum": 16000
                }
              }
            },
            "highpass": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "hz"
                },
                "number": {
                  "type": "number",
                  "minimum": 40,
                  "maximum": 400
                }
              }
            },
            "predelay": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "ms"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 200
                }
              }
            },
            "mix": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "unit"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "comp_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "params"
      ],
      "properties": {
        "id": {
          "const": "comp"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "detect": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "text"
              ],
              "properties": {
                "unit": {
                  "const": "enum"
                },
                "text": {
                  "enum": [
                    "peak",
                    "rms"
                  ]
                }
              }
            },
            "threshold": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "db"
                },
                "number": {
                  "type": "number",
                  "minimum": -40,
                  "maximum": 0
                }
              }
            },
            "ratio": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "unit"
                },
                "number": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 20
                }
              }
            },
            "knee": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "db"
                },
                "number": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 12
                }
              }
            },
            "attack": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "ms"
                },
                "number": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 100
                }
              }
            },
            "release": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "number"
              ],
              "properties": {
                "unit": {
                  "const": "ms"
                },
                "number": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 1000
                }
              }
            },
            "makeup": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit",
                    "text"
                  ],
                  "properties": {
                    "unit": {
                      "const": "enum"
                    },
                    "text": {
                      "const": "auto"
                    }
                  }
