(* Generated by go generate ./language/grammar from language/grammar/grammar.go. Do not edit.
   Quoted forms are literal terminals; /.../ forms are regular expressions.
   Brackets mean optional, braces mean zero-or-more, and parentheses group.
   Spaces, tabs, CR, LF, and // comments are ignored between tokens.
   Expression precedence (larger levels bind more tightly):
     level 2 is left-associative for "*", "/"
     level 1 is left-associative for "+", "-"
   The DSL may also carry lexical priority, fields, and parser test cases;
   EBNF shows accepted forms but does not encode that parser metadata.
   Edition-specific limits are in edition-1.md and edition-2.md. *)

source_file ::= [ "cicada" , integer ] , { _declaration } ;
_declaration ::= title_decl | tempo_decl | key_decl | seed_decl | instrument_decl | kit_decl |
                 track_decl | phrase_decl | acid_pattern | note_pattern | drum_pattern | scene_decl |
                 song_decl | fx_decl | bus_decl | master_decl | export_decl | arrange_decl |
                 asset_decl | clip_decl | sampler_decl | live_decl ;
asset_decl ::= "asset" , identifier , string , "{" , { param_decl } , "}" ;
clip_decl ::= "clip" , identifier , identifier , "{" , { param_decl } , "}" ;
sampler_decl ::= "sampler" , identifier , "{" , { param_decl } , "}" ;
title_decl ::= "title" , string ;
tempo_decl ::= "tempo" , number ;
key_decl ::= "key" , key_root , identifier ;
seed_decl ::= "seed" , integer ;
track_decl ::= "track" , identifier , identifier , "{" , { mix_setting } , "}" ;
instrument_decl ::= "instrument" , identifier , "{" , [ instrument_octave ] , { instrument_param } ,
                    voice_decl , "}" ;
instrument_octave ::= "octave" , "=" , integer , [ ";" ] ;
kit_decl ::= "kit" , identifier , "{" , { kit_binding } , "}" ;
kit_binding ::= identifier , "=" , kit_target , [ ";" ] ;
kit_target ::= identifier | "builtin" , "." , identifier ;
instrument_param ::= "param" , identifier , [ ":" , identifier ] , "=" , number , [ ";" ] ;
voice_decl ::= "voice" , identifier , "{" , { let_stmt } , out_stmt , "}" ;
let_stmt ::= "let" , identifier , "=" , expression , [ ";" ] ;
out_stmt ::= "out" , "=" , expression , [ ";" ] ;
expression ::= expression , ("+" | "-") , expression | expression , ("*" | "/") , expression |
               call_expr | number | identifier | "(" , expression , ")" ;
call_expr ::= identifier , "(" , [ expression , { "," , expression } ] , ")" ;
param_decl ::= identifier , "=" , value ;
send_decl ::= "send" , identifier , "=" , number , [ "pre" ] ;
mix_setting ::= send_decl | param_decl ;
fx_decl ::= "fx" , identifier , [ identifier ] , "{" , { param_decl } , "}" ;
bus_decl ::= "bus" , identifier , "{" , { mix_setting } , "}" ;
master_decl ::= "master" , "{" , { mix_setting } , "}" ;
export_decl ::= "export" , identifier , "{" , { param_decl } , "}" ;
phrase_decl ::= "phrase" , identifier , [ "acid" ] , "{" , { acid_step } , "}" ;
acid_pattern ::= "pattern" , identifier , "acid" , { pattern_attr } , "{" , { pattern_attr } ,
                 { acid_step | phrase_use } , "}" ;
note_pattern ::= "pattern" , identifier , [ "notes" ] , { pattern_attr } , "{" , { pattern_attr } ,
                 { acid_step | phrase_use } , "}" ;
phrase_use ::= "use" , identifier , [ "*" , integer ] ,
               [ "transpose" , "=" , number | "+" , number ] ;
drum_pattern ::= "pattern" , identifier , "drums" , { pattern_attr } , "{" , { pattern_attr } ,
                 { drum_lane } , "}" ;
pattern_attr ::= identifier , "=" , number ;
acid_step ::= "." | "-" | "|" | acid_note ;
acid_note ::= pitch , { octave_shift } , { modifier } ;
pitch ::= degree | letter_pitch ;
degree ::= /[1-7][#b]?/ ;
letter_pitch ::= /[a-g][#b]?[0-6]?/ ;
octave_shift ::= "'" | "," ;
modifier ::= "^" | "~" | ratchet | probability ;
drum_lane ::= (drum_lane_label | identifier , ":") , { drum_hit } , [ ";" ] ;
drum_lane_label ::= /[a-z][a-z0-9_-]*:/ ;
drum_hit ::= ("." | hit | accent_hit | velocity_hit) , [ ratchet ] , [ probability ] ;
hit ::= /x[1-9]?/ ;
accent_hit ::= /X/ ;
velocity_hit ::= /x[1-9]/ ;
ratchet ::= "*" , integer ;
probability ::= ("?" | "%") , integer ;
scene_decl ::= "scene" , identifier , "{" , { scene_assignment } , "}" ;
scene_assignment ::= scene_target , "=" , scene_value ;
scene_target ::= parameter_path | identifier ;
scene_value ::= number | identifier | string | fraction ;
parameter_path ::= /[a-z_][a-z0-9_-]*(\.[a-z_][a-z0-9_-]*)+/ ;
song_decl ::= "song" , "{" , { song_entry } , "}" ;
song_entry ::= identifier , [ "*" , integer ] ;
value ::= musical_position | bar_count | tick_count | number | insert_chain | identifier | string |
          fraction ;
insert_chain ::= identifier , { "->" , identifier } ;
fraction ::= /[0-9]+\/[0-9]+[tT.]?/ ;
number ::= /-?[0-9]+(\.[0-9]+)?(frames|LUFS|dBTP|LU|khz|kHz|hz|Hz|ms|s|db|dB|%)?/ ;
integer ::= /[0-9]+/ ;
key_root ::= /[a-g][#b]?/ ;
string ::= /"([^"\\]|\\.)*"/ ;
identifier ::= /[a-z_][a-z0-9_-]*/ ;
comment ::= /\/\/[^\n]*/ ;
live_decl ::= "live" , "{" , { live_land | live_phrase | live_macro | live_layers } , "}" ;
live_land ::= "land" , "=" , (identifier | bar_count) , [ ";" ] ;
live_phrase ::= "phrase" , "=" , bar_count , [ ";" ] ;
live_macro ::= "macro" , identifier , "=" , number , [ "smooth" , number ] , [ ";" ] ;
live_layers ::= "layers" , identifier , "{" , { live_layer | live_attack | live_release } , "}" ;
live_layer ::= identifier , ">=" , number , [ ";" ] ;
live_attack ::= "attack" , bar_count , [ ";" ] ;
live_release ::= "release" , bar_count , [ ";" ] ;
bar_count ::= /-?[0-9]+(\.[0-9]+)?bars?/ ;
arrange_decl ::= "arrange" , "{" , { place_decl | marker_decl } , "}" ;
place_decl ::= "place" , identifier , identifier , identifier , "{" , { param_decl } , "}" ;
marker_decl ::= "marker" , identifier , "{" , { param_decl } , "}" ;
musical_position ::= /@[0-9]+\.[0-9]+\.[0-9]+/ ;
tick_count ::= /[0-9]+ticks/ ;
