cicada 2
title "Flush check: a dark drive's tails in silence, then its mix to zero while notes play"
tempo 240
key a minor
seed 1

fx warm drive {
  shape = hard
  gain = 12dB
  tone = 1kHz
  mix = 0.7
}

track bass acid {
  insert = warm
}

pattern riff {
  1 . 5 . | 1 . 3 .
}

pattern rest {
  . . . . | . . . .
}

scene play {
  bass = riff
}

scene hush {
  bass = rest
}

automate warm.mix {
  @11.1.1 0.7
  @12.1.1 0
}

song {
  play*2
  hush*6
  play*10
}
