cicada 2
title "Flush check: a sidechain breakdown (makeup 0 dB, 10 ms release)"
tempo 120
key a minor
seed 1

fx comp comp {
  detect = peak
  threshold = -24dB
  ratio = 4
  knee = 6dB
  attack = 5ms
  release = 10ms
  makeup = 0dB
  sidechain = beat
  mix = 1
}

track bass acid {
  cutoff = 620Hz
  out = music
}

track beat drums {}

pattern riff {
  1 . . . | 5 . . . | 1 . . . | 3 . . .
}

pattern beat-a drums {
  bd: X...x...X...x...
}

pattern hush drums {
  bd: ................
}

scene main {
  bass = riff
  beat = beat-a
}

scene breakdown {
  bass = riff
  beat = hush
}

song {
  main*1
  breakdown*8
}

bus music {
  insert = comp
}
