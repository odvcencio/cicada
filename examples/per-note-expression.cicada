title "Per-note expression"

tempo 120

key c major

instrument expressive {
  voice mono {
    let tone = sine(pitch)
    let envelope = env(gate, 300ms)
    let touch = 0.7 + pressure * 0.3
    let color = 0.5 + timbre * 0.5
    out = tone * envelope * velocity * touch * color
  }
}

track lead expressive {}

track bass acid {
  level = -12dB
}

pattern take {
  c4 - - - g4 - - .
  bend: 0ct +50ct +100ct 0ct -50ct . 0ct .
  vibrato: 0ct . 12ct . 4ct . 0ct .
  pressure: 0 0.3 0.8 . 0.6 . 0.2 0
  timbre: . 0.6 0.9 . 0.4 . 0.5 .
}

pattern low {
  c2 - - - g2 - - .
  bend: 0ct -25ct -50ct 0ct +25ct . 0ct .
  vibrato: 0ct . 4ct . 2ct . 0ct .
}

scene main {
  lead = take
  bass = low
}

song {
  main*2
}
