title "first-song"

tempo 120

key a minor

track drums drums {}

track bass fm_bass {}

track chords poly_keys {
  octave = 3
}

fx ceiling limiter {
  ceiling = -1dBTP
}

master {
  insert = ceiling
}

pattern beat drums {
  bd: X... .... X... ....
  sd: .... X... .... X...
  ch: x.x. x.x. x.x. x.x.
}

pattern pulse {
  1 . . 1 . . 1 . 6, . . 6, . . 7, .
}

pattern progression {
  [1 3 5] - - - - - - . [6, 1 3] - - - - - - .
}

scene main {
  drums = beat
  bass = pulse
  chords = progression
}

scene break {
  drums = stop
  bass = pulse
  chords = progression
}

song {
  main*4
  break*4
}
