// Bon Voyage! main theme: phrases, patterns and scenes. Step patterns only.
phrase ph_vibes_a {
  f5 - - eb5 d5 - - bb5 | - - g5 - . . bb4 c5 | d5 - - c5 d5 - - f5 | - - eb5 - . . c5 d5 | a5 - - g5 f5 - - d6 | - - - c6 - - bb5 a5 | bb5 - - a5 g5 - - f5 | - - d5 - . . a4 c5
}

phrase ph_bells_a {
  f6 - - eb6 d6 - - bb6 | - - g6 - . . bb5 c6 | d6 - - c6 d6 - - f6 | - - eb6 - . . c6 d6 | a6 - - g6 f6 - - d6' | - - - c6' - - bb6 a6 | bb6 - - a6 g6 - - f6 | - - d6 - . . a5 c6
}

phrase ph_pad_a {
  [bb3 d4 f4 a4] - - - - - - - | [g3 bb3 eb4 f4] - - - - - - - | [bb3 d4 f4 a4] - - - [g3 bb3 d4 f4] - - - | [g3 bb3 c4 eb4] - - - [f3 bb3 c4 eb4] - - - | [bb3 d4 f4 a4] - - - - - - - | [g3 bb3 d4 eb4] - - - - - - - | [g3 bb3 c4 eb4] - - - [f3 bb3 c4 eb4] - - - | [bb3 c4 d4 f4] - - - [f3 a3 c4 eb4] - - -
}

phrase ph_line_a2 {
  . . . . . . . . | . . eb5 - bb4 - - - | f4 - - - . . . . | . . c5 - g4 - - - | - - . . . . . . | . . g5 - d5 - - - | - - . . . . . . | . . bb4 - c5 - eb4 -
}

phrase ph_keys_a {
  [f3 a3 c4 d4] - - [f3 a3 c4 d4] - - [f3 a3 c4 d4] . | [g3 bb3 eb4 f4] - - [g3 bb3 eb4 f4] - - [g3 bb3 eb4 f4] . | [f3 a3 c4 d4] - - [f3 bb3 d4] - - [f3 bb3 d4] . | [g3 bb3 eb4] - - [f3 bb3 c4 eb4] - - [f3 bb3 c4 eb4] . | [f3 a3 c4 d4] - - [f3 a3 c4 d4] - - [f3 a3 c4 d4] . | [g3 bb3 d4 f4] - - [g3 bb3 d4 f4] - - [g3 bb3 d4 f4] . | [g3 bb3 eb4] - - [f3 bb3 c4 eb4] - - [f3 bb3 c4 eb4] . | [f3 bb3 c4 d4] - - [f3 a3 c4 eb4] - - [f3 a3 c4 eb4] .
}

phrase ph_bass_a {
  bb1 - - bb1 f2 - - eb2 | - - eb2 - bb1 - c2 - | bb1 - - bb1 g1 - - c2 | - - c2 - f1 - - f2 | bb1 - - bb1 f2 - - eb2 | - - eb2 - bb2 - g2 - | c2 - - c2 f1 - c2 - | bb1 - - bb1 f1 - a1 -
}

phrase ph_harp_gliss {
  bb2 c3 d3 eb3 f3 g3 a3 bb3 c4 d4 eb4 f4 g4 a4 bb4 c5 d5 eb5 f5 g5 a5 bb5 c6 d6 . . . . . . . .
}

// vibes
pattern vibes_a notes {
  step = 1/8
  gate = 100
  use ph_vibes_a
}

pattern vibes_a_up notes {
  step = 1/8
  gate = 100
  transpose = 1
  use ph_vibes_a
}

pattern vibes_break notes {
  step = 1/8
  gate = 100
  d5 f5 - a5 c6 - - d6 | - - c6 bb5 g5 - - . | . . . . . . . . | . . . . . . . . | f5 a5 - c6 d6 - c6 bb5 | g5 - - bb5 g5 - f5 . | . . . . . . . . | . . . . . . . .
}

pattern vibes_tag notes {
  step = 1/8
  gate = 100
  f#5 - - e5 d#5 - - b5 | - - g#5 - f#5 - - . | c#5 - - d#5 e5 - b5 - | - - a#5 - - - . . | c#6 - - - - - - - | - - - - - - - - | - - - - - - - - | - - - - - - - -
}

// bells
pattern bells_sparkle notes {
  step = 1/8
  gate = 90
  . . . . . . f6 . | . . bb6 . . . g6 . | . . . . a6 a6 . . | . . . . . . bb6 . | . . . . . . d6 . | . . g6 . . . . . | . . . . eb6 eb6 . . | f6 . . . c6 . . .
}

pattern bells_a notes {
  step = 1/8
  gate = 90
  use ph_bells_a
}

pattern bells_a_up notes {
  step = 1/8
  gate = 90
  transpose = 1
  use ph_bells_a
}

pattern bells_tag notes {
  step = 1/8
  gate = 90
  . . . . . . . . | . . . . f#6 . . . | . . . . . . b6 . | . . a#6 . . . . . | c#6' - - - - - - - | . . . . . . . . | . . . . . . . . | . . . . . . . .
}

