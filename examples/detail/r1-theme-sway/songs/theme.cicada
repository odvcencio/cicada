// drums
pattern drums_groove drums {
  step = 1/16
  swing = 56%
  bd: X... ..x. X... .... X... ..x. X... .... X... ..x. X... .... X... ..x. X... x...
  rs: .... X... .... X... .... X... .... X... .... X... .... X... .... X... .... X...
  ch: x6.x4x3 x6.x4. x6.x4x3 x6.x4. x6.x4x3 x6.x4. x6.x4x3 x6.x4. x6.x4x3 x6.x4. x6.x4x3 x6.x4. x6.x4x3 x6.x4. x6.x4x3 x6...
  oh: .... .... .... .... .... .... .... .... .... .... .... .... .... .... .... ..x5.
}

pattern drums_groove_b drums {
  step = 1/16
  swing = 56%
  bd: X... .... X... ..x. X... .... X... ..x. X... .... X... ..x. X... .... X... ..x.
  rs: .... x6... .... x6... .... x6... .... x6... .... x6... .... x6... .... x6... .... x6...
  cy: x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3.
}

pattern drums_fill drums {
  step = 1/16
  bd: X... .... .... ....
  rs: .... .... x3x4x5x6 x7x8x9X
  ch: x6.x4x3 .... .... ....
}

pattern drums_intro drums {
  step = 1/16
  swing = 56%
  bd: .... .... .... .... .... .... .... .... X... .... X... .... X... ..x. X... ....
  rs: .... .... .... .... .... X... .... X... .... X... .... X... .... X... .... X...
  ch: x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3. x5.x3.
}

pattern drums_tag drums {
  step = 1/8
  bd: X.x. X.x. X.x. X.x. X.x. X.x. X.x. X... X... .... .... .... .... .... .... ....
  rs: ..X. ..X. ..X. ..X. ..X. ..X. ..X. .... .... .... .... .... .... .... .... ....
  ch: x5x3x5x3 x5x3x5x3 x5x3x5x3 x5x3x5x3 x5x3x5x3 x5x3x5x3 x5x3x5x3 x5x3.. .... .... .... .... .... .... .... ....
  oh: .... .... .... .... .... .... .... .... X... .... .... .... .... .... .... ....
  cy: .... .... .... .... .... .... .... .... x7... .... .... .... .... .... .... ....
}

scene theme_loop {
  vibes = vibes_a
  bells = bells_a
  brass = off
  strings_pad = pad_a
  strings_line = off
  keys = keys_a
  harp = off
  bass = bass_a
  drums = drums_groove
}

scene lounge_loop {
  vibes = vibes_a
  bells = off
  brass = off
  strings_pad = pad_a
  strings_line = off
  keys = keys_a
  harp = off
