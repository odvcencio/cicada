// Level lanes follow the transport, also after a Director state lands. The strings_pad
// swell ends in bar 8 at the track's own level; the other three lanes sit on tracks that
// both state scenes switch off.
automate strings_line.level {
  @25.1.1 -2.5dB @33.1.1 -5.5dB step
}

automate brass.level {
  @49.1.1 -10dB @57.1.1 -7dB step
}

automate harp.level {
  @24.4.4 2dB @33.1.1 -4dB step @48.4.4 2dB step @60.4.4 -4dB step
}

automate strings_pad.level {
  @1.1.1 -22dB @8.4.4 -12dB smooth
}
