cicada 2

title "Bon Voyage!"

tempo 92

key bb major

seed 4242

// R1 adds motion without changing the theme's notes.
lfo drift { wave = triangle rate = 8bars }
sway keys_wander { rate = 2bars octaves = 2 }
sway brass_wander { rate = 4bars octaves = 2 }
contour pad_swell { period = 4bars @0 -1 @1/4 1 smooth @1 -1 }

mod drift -> strings_pad.pan depth = 0.2
mod keys_wander -> keys.level depth = 1.5dB
mod pad_swell -> strings_pad.level depth = 2dB

track vibes model_vibraphone {
  level = -9dB
  pan = -0.2
  insert = sparkle
  send echo = -18dB
  send hall = 0dB
  octave = 4
}

track bells tine_bell {
  level = -9dB
  pan = 0.3
  insert = sparkle
  send echo = -18dB
  send hall = 0dB
  voices = 2
}

track brass brass_lead {
  level = -7dB
  send hall = -4.5dB
}

track strings_pad string_machine {
  level = -12dB
  pan = -0.3
  send hall = -0.5dB
  voices = 4
  attack = 400ms
  release = 900ms
}

track strings_line string_machine {
  level = -5.5dB
  pan = 0.3
  send hall = -1.5dB
  voices = 2
  attack = 120ms
  release = 500ms
}

track keys tine_ep {
  level = -12dB
  pan = 0.1
  send hall = -4dB
  voices = 6
}

track harp harp {
  level = -4dB
  pan = -0.1
  send hall = 0dB
}

track bass bass {
  level = -12dB
}

track drums band_kit {
  level = -12dB
  send hall = -9dB
}

bus music {
  insert = duck
}

live {
  land = phrase
  phrase = 8bars
  state theme = theme_loop
  state lounge = lounge_loop
  transition theme -> lounge quantize phrase crossfade 2s
  transition lounge -> theme quantize phrase
}

arrange {
  place vibes-vibes-a-b9 vibes vibes_a {
    at = @9.1.1 length = 8bars
  }
  place vibes-vibes-a-b17 vibes vibes_a {
    at = @17.1.1 length = 8bars
  }
