// Every construct Cicada renders today, in one summer-night score.
// `cicada highlight examples/cicada-chorus.cicada` shows each one in color.
title "Cicada chorus"

tempo 126.5

key e minor

seed 1717

// A cicada buzzes a ribbed tymbal against a hollow body: noise through a
// highpass, a short click envelope, and a ring eight times the note pitch.
instrument tymbal {
  octave = 2
  param body = 5200Hz
  param snap = 18ms
  param grit = 0.4
  voice mono {
    let buzz = highpass(noise(), body)
    let click = env(gate, snap)
    let ring = sine(pitch * 8 - 30Hz) * click
    out = tanh(mix(buzz, ring, grit) * clamp(velocity * 2, 0, 1)) * click
  }
}

instrument nightbass {
  octave = 2
  param cutoff = 480Hz
  param decay = 0.3s
  param bite = 60%
  voice mono {
    let body = mix(saw(pitch), square(pitch / 2), 0.3)
    let shape = env(gate, decay)
    let sweep = cutoff * exp2(shape * 2.5)
    let dark = lowpass(ladder(body, sweep, bite), sample_rate / 4)
    out = highpass(diode(dark, sweep + 120Hz, 0.2), 30Hz) * (shape * velocity)
  }
}

track bass acid {
  cutoff = 540Hz
  reso = 0.66
  envmod = 0.7
  decay = 320ms
  accent = 0.85
  drive = 0.3
  filter = diode
  savage = off
  level = -2dB
}

track drums drums {
  bd_tune = 55Hz
  bd_decay = 400ms
  ch_decay = 45ms
  level = -1.5dB
}

track buzz tymbal {
  body = 6kHz
  level = -9dB
  pan = 0.35
}

track low nightbass {
  cutoff = 360Hz
  pan = -0.2
}

// Phrases expand before scheduling; `use` splices their steps in place.
phrase chirp {
  1^ 1*2 . 5~ | 7, 1' - .
}

phrase trill {
  1*3 . 1?50 .
}

pattern bass-a {
  swing = 56%
  gate = 60%
  seed = 7
  1^ . 1~ 3 . 1 4# 5 | 1 . 7,~ 1 5^*2 3?70 1 -
}

pattern bass-b {
  swing = 56%
  gate = 60%
  use chirp
  use chirp +7
}

pattern chorus {
  gate = 30%
  transpose = 12
  use trill*4
}

pattern low-a {
  swing = 54%
  e2 . g b1 | e2'^ d~ c#2 bb1
}

// Drum rows are grids: x hits, X accents, x1-x9 set the velocity.
pattern beat drums {
  bd: X..x ..x. X..x .x..
  sd: .... X... .... Xx3..
  ch: xx.x xx.x x*2x.x xx?60xx
  oh: ..x. ..x. ..x. ..x.
  cp: .... x1... .... X...
  rs: ..x5. .... ..x2. ....
}

scene dusk {
  bass = bass-a
  drums = beat
  low = low-a
  buzz = stop
}

scene chorus {
  bass = bass-b
  buzz = chorus
}

scene hush {
  bass = stop
  drums = stop
}

song {
  dusk*4
  chorus*8
  hush
  chorus*4
}
