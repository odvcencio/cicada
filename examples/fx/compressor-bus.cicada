title "Sidechain compressor"

tempo 120

key a minor

seed 4242

fx comp comp {
  detect = peak
  threshold = -24dB
  ratio = 4
  knee = 6dB
  attack = 5ms
  release = 150ms
  makeup = 0dB
  sidechain = beat
  mix = 1
}

track bass acid {
  cutoff = 620Hz
}

track beat drums {}

pattern riff {
  1 . . . | 5 . . . | 1 . . . | 3 . . .
}

pattern beat-a drums {
  bd: X...x...X...x...
}

scene main {
  bass = riff
  beat = beat-a
}

song {
  main*4
}

bus music {
  insert = comp
}
