cicada 1

title "Drive insert"

tempo 130

key a minor

seed 4242

fx drive {
  shape = hard
  gain = 18db
  tone = 12khz
  mix = 0.75
}

track bass acid {
  cutoff = 620hz
  reso = 0.62
  insert = drive
}

track beat drums {}

pattern riff acid steps = 16 {
  1^ . 1~ 5 | . 1 7, . | 1^ . 3 . | 5^ . 1 .
}

pattern beat-a drums steps = 16 {
  bd: X...x...X...x...;
  sd: ....X.......X...;
  ch: x.x.x.x.x.x.x.x.;
}

scene main {
  bass = riff
  beat = beat-a
}

song {
  main*4
}
