title "Drive insert"

tempo 130

key a minor

seed 4242

fx drive drive {
  shape = hard
  gain = 18dB
  tone = 12kHz
  mix = 0.75
}

track bass acid {
  cutoff = 620Hz
  reso = 0.62
  insert = drive
}

track beat drums {}

pattern riff {
  1^ . 1~ 5 | . 1 7, . | 1^ . 3 . | 5^ . 1 .
}

pattern beat-a drums {
  bd: X...x...X...x...
  sd: ....X.......X...
  ch: x.x.x.x.x.x.x.x.
}

scene main {
  bass = riff
  beat = beat-a
}

song {
  main*4
}
