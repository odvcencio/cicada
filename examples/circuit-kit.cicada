cicada 1

title "Circuit kit"

tempo 128

key a minor

seed 4242

// Every sound in this sketch is defined in the score.
instrument subline {
  param cutoff: hz = 540hz;
  voice mono {
    let body = saw(pitch);
    let shape = env(gate, 260ms);
    out = ladder(body, cutoff * exp2(shape * 2.2), 0.48) * shape;
  }
}

instrument kick {
  voice mono {
    let shape = env(gate, 180ms);
    out = sine(48hz * exp2(shape * 2.5)) * shape;
  }
}

instrument snare {
  voice mono {
    let shape = env(gate, 110ms);
    out = highpass(noise(), 1400hz) * shape;
  }
}

instrument hat {
  voice mono {
    let shape = env(gate, 45ms);
    out = highpass(noise(), 4900hz) * shape;
  }
}

track bass subline {
  cutoff = 620hz
}

track bd kick {}

track sd snare {}

track ch hat {}

pattern bassline notes steps = 16 swing = 54 {
  1 . . 1 3 . . . | 5 . 5 . 7 . 5 .
}

pattern kickline notes steps = 16 {
  1 . . . 1 . . . | 1 . . . 1 . . .
}

pattern snareline notes steps = 16 {
  . . . . 1 . . . | . . . . 1 . . .
}

pattern hatline notes steps = 16 {
  1 . 1 . 1 . 1 . | 1 . 1 . 1 . 1 .
}

scene groove {
  bass = bassline
  bd = kickline
  sd = snareline
  ch = hatline
}

song {
  groove*4
}
