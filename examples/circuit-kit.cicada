title "Circuit kit"

tempo 128

key a minor

seed 4242

// Every sound in this sketch is defined in the score.
instrument subline {
  octave = 2
  param cutoff = 540Hz
  voice mono {
    let body = saw(pitch)
    let shape = env(gate, 260ms)
    out = ladder(body, cutoff * exp2(shape * 2.2), 0.48) * shape
  }
}

instrument kick {
  octave = 2
  voice mono {
    let shape = env(gate, 180ms)
    out = sine(48Hz * exp2(shape * 2.5)) * shape
  }
}

instrument snare {
  octave = 2
  voice mono {
    let shape = env(gate, 110ms)
    out = highpass(noise(), 1400Hz) * shape
  }
}

instrument hat {
  octave = 2
  voice mono {
    let shape = env(gate, 45ms)
    out = highpass(noise(), 4900Hz) * shape
  }
}

track bass subline {
  cutoff = 620Hz
}

track bd kick {}

track sd snare {}

track ch hat {}

pattern bassline {
  swing = 54%
  1 . . 1 3 . . . | 5 . 5 . 7 . 5 .
}

pattern kickline {
  1 . . . 1 . . . | 1 . . . 1 . . .
}

pattern snareline {
  . . . . 1 . . . | . . . . 1 . . .
}

pattern hatline {
  1 . 1 . 1 . 1 . | 1 . 1 . 1 . 1 .
}

scene groove {
  bass = bassline
  bd = kickline
  sd = snareline
  ch = hatline
}

song {
  groove*4
}
