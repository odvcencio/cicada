// Anywhere You Are — Draco Skysong, for Danilo.
// An original love song: layered electronic soul with a late-night dance pulse.
// Piano and reed in front; moving strings and a wide wordless synth choir behind.
// 80 bars at 108 BPM. The guide is a suggested vocal melody, not a vocal recording.
cicada 2

title "Anywhere You Are"

tempo 108

key d major

seed 861025

fx room reverb {
  size = 1.08
  decay = 3.35s
  damp = 5100Hz
  highpass = 320Hz
  predelay = 34ms
  mix = 1
}

fx echo delay {
  time = 1/8.
  feedback = 0.34
  damp = 3500Hz
  pingpong = on
  width = 1
  mix = 1
}

fx air eq {
  type = high_shelf
  frequency = 9kHz
  q = 0.707
  gain = 0.5dB
}

fx glue comp {
  threshold = -16dB
  ratio = 1.5
  knee = 6dB
  attack = 32ms
  release = 190ms
  makeup = 8dB
  mix = 0.5
}

fx ceiling limiter {
  ceiling = -1dBTP
  lookahead = 4ms
  release = 140ms
}

// Separate frequency windows leave the dry vocal and bass in the center.
fx piano_floor eq {
  type = highpass
  frequency = 125Hz
  q = 0.65
}

fx piano_space eq {
  type = peak
  frequency = 2400Hz
  q = 0.75
  gain = -1.7dB
}

fx reed_floor eq {
  type = highpass
  frequency = 210Hz
  q = 0.707
}

fx reed_shade eq {
  type = lowpass
  frequency = 4100Hz
  q = 0.65
}

fx strings_floor eq {
  type = highpass
  frequency = 260Hz
  q = 0.65
}

fx pluck_shade eq {
  type = high_shelf
  frequency = 4200Hz
  q = 0.707
  gain = -2.2dB
}

instrument roundheart {
  voice mono {
    let amp = adsr(gate, 8ms, 180ms, 0.72, 150ms)
    out = lowpass(sine(pitch) *0.8+saw(pitch) *0.12, 560Hz) *amp*velocity*0.52
  }
}

instrument satin {
  voice poly {
    let amp = adsr(gate, 260ms, 900ms, 0.62, 1200ms)
    let body = (saw(pitch) +saw(pitch*1.0025)) *0.5
    out = highpass(svf(body, 1550Hz, 0.15), 230Hz) *amp*velocity*0.19
  }
}

instrument porcelain {
  voice poly {
    let strike = noise() *env(gate, 2ms) *velocity
    let string = comb(strike, 1/pitch, 0.987, 0.6)
    out = (lowpass(string, 3400Hz) *0.25+sine(pitch) *env(gate, 480ms) *0.13) *env(gate, 1300ms)
  }
}

instrument lanternvoice {
  voice mono {
    let amp = adsr(gate, 35ms, 220ms, 0.7, 180ms)
    let tone = sine(pitch) *0.62+sine(pitch*2) *0.23+sine(pitch*3) *0.09
    out = lowpass(tone, 2100Hz) *amp*velocity*0.3
  }
}

instrument glowbell {
  voice mono {
    let amp = env(gate, 850ms)
    out = pm(pitch, sine(pitch*2), amp*1.1) *amp*velocity*0.16
  }
}

// Two differently voiced, softly breathed parts form one distant ensemble.
// These are original synthesizers, not sampled human singers.
instrument afterimage {
  param throat = 1150Hz
  param air = 0.016
  voice poly {
    let amp = adsr(gate, 420ms, 1100ms, 0.76, 1650ms)
    let harmonics = sine(pitch) *0.52+ (saw(pitch*0.9992) +saw(pitch*1.0013)) *0.115
    let vowel = lowpass(harmonics, throat) *0.82+ (lowpass(harmonics, 2800Hz) -lowpass(harmonics, 1500Hz)) *0.2
    let body = highpass(vowel+lowpass(noise(), 4300Hz) *air, 290Hz)
    out = (body+delay(body, 11ms) *0.13+delay(body, 19ms) *0.055) *amp*velocity*0.36
  }
}

track keys tine_ep {
  level = -4dB
  pan = -0.12
  insert = piano_floor -> piano_space
  send room = -12dB
  voices = 8
  release = 520ms
  hammer_felt = 0.72
  pickup_distance = 0.86
  tremolo = 0.13
  tremolo_rate = 0.83Hz
  auto_pan = 0.18
}

track bass roundheart {
  level = -10dB
}

track silk satin {
  level = -10dB
  pan = 0.08
  send room = -4dB
}

track guitar porcelain {
  level = -9dB
  pan = -0.38
  insert = pluck_shade
  send echo = -9dB
  send room = -8dB
}

track answer glowbell {
  level = -15dB
  pan = 0.48
  send echo = -8dB
  send room = -6dB
}

track guide lanternvoice {
  level = -17dB
  send echo = -24dB
  send room = -20dB
}

track drums drums {
  level = -13dB
  send room = -22dB
  bd_decay = 190ms
  sd_decay = 155ms
  ch_decay = 38ms
}

// Reed replies are close and percussive; strings carry a separate singing line.
track ember reed_ep {
  level = -3dB
  pan = 0.36
  insert = reed_floor -> reed_shade
  send echo = -17dB
  send room = -12dB
  voices = 6
  pickup_distance = 0.92
  hammer_felt = 0.78
  decay = 2.8s
  release = 420ms
  drive = 0.08
  tremolo = 0.18
  tremolo_rate = 2.7Hz
  auto_pan = 0.16
}

track strings string_machine {
  level = -8dB
  pan = 0.24
  insert = strings_floor
  send room = -3dB
  voices = 8
  octave16 = 0.06
  octave8 = 0.83
  octave4 = 0.17
  attack = 140ms
  release = 950ms
  cutoff = 3100Hz
  velocity = 0.72
  ensemble = 0.46
  ensemble_rate = 0.53
}

track choir_left afterimage {
  level = -12dB
  pan = -0.64
  send room = -1dB
  throat = 1080Hz
  air = 0.014
}

track choir_right afterimage {
  level = -13dB
  pan = 0.64
  send echo = -21dB
  send room = -2dB
  throat = 1460Hz
  air = 0.021
}

track danilo audio {
  level = -9dB
}

// Spacious inversions leave the middle register for a real lead vocal.
pattern verse-keys notes {
  step = 1/4
  gate = 80%
  [d3 f#3 a3 e4] - . [f#3 a3 c#4 e4] | [c#3 e3 a3 b3] - . [e3 a3 b3 c#4] | [b2 d3 f#3 a3] - . [d3 f#3 a3 c#4] | [g2 b2 d3 a3] - . [b2 d3 f#3 a3]
  velocity: 82 . . 63 78 . . 66 84 . . 67 81 . . 64
}

pattern chorus-keys notes {
  step = 1/4
  gate = 85%
  [g2 b2 d3 f#3] - [b2 d3 f#3 a3] . | [f#2 a2 d3 e3] - [a2 d3 e3 f#3] . | [e2 g2 b2 f#3] - [g2 b2 d3 f#3] . | [a2 c#3 f#3 g3] - [c#3 e3 f#3 b3] .
  velocity: 96 . 76 . 92 . 72 . 94 . 78 . 98 . 82 .
}

pattern bridge-keys notes {
  step = 1/2
  gate = 94%
  [b2 d3 f#3 a3] - | [f#2 a2 c#3 e3] - | [g2 b2 d3 f#3] - | [a2 c#3 e3 g3] -
}

pattern verse-bass {
  step = 1/8
  gate = 76%
  d2 . . a2 . d2 . c#2 | c#2 . . e2 . a1 . . | b1 . . f#2 . b1 . a1 | g1 . . d2 . a1 c#2 .
}

pattern chorus-bass {
  step = 1/8
  gate = 82%
  g1 . d2 . . g2 . f#2 | f#1 . a1 . . d2 . c#2 | e2 . b1 . . e2 f#2 . | a1 . e2 . g2 . e2 c#2
}

pattern bridge-bass {
  step = 1/2
  gate = 94%
  b1 - f#1 - g1 - a1 -
}

pattern verse-pad notes {
  step = 1/2
  gate = 96%
  [a3 e4] - [a3 e4] - [f#3 c#4] - [d3 a3] -
}

pattern chorus-pad notes {
  step = 1/2
  gate = 96%
  [b3 f#4] - [a3 e4] - [b3 f#4] - [c#4 g4] -
}

pattern guitar-verse {
  step = 1/8
  gate = 52%
  . a3 . e4 . f#4 . e4 | . a3 . c#4 . e4 . c#4 | . f#3 . c#4 . d4 . c#4 | . d3 . a3 . b3 . a3
}

pattern guitar-chorus {
  step = 1/8
  gate = 58%
  . d4 . f#4 . a4 . f#4 | . a3 . e4 . f#4 . e4 | . b3 . f#4 . g4 . f#4 | . c#4 . e4 . g4 . e4
}

pattern little-answer {
  step = 1/8
  gate = 60%
  . . . . a4 f#4 e4 . | . . . . . e4 c#4 . | . . . . f#4 e4 d4 . | . . . . . c#4 b3 a3
}

// "Anywhere you are / I can find my way back home."
// Let the held notes breathe; replace or mute this guide when recording.
pattern love-hook {
  step = 1/8
  gate = 85%
  a3 b3 d4 - f#4 - e4 . | d4 - b3 a3 - . . . | f#3 a3 b3 - d4 - e4 . | f#4 - e4 d4 - - . .
}

pattern last-line {
  step = 1/8
  gate = 88%
  d4 - e4 f#4 - e4 d4 . | b3 - a3 - . . . . | a3 b3 d4 - e4 - f#4 . | e4 - d4 - - - . .
}

pattern pulse drums {
  swing = 55%
  bd: X... .... ..x5. .... X... ..x4. .... ..x5.
  sd: .... x6... .... x6... .... x6... ..x2. x6...
  ch: x3.x2. x4.x2. x3.x2. x4.x3. x3.x2. x4.x2. x3.x2. x5.x3.
  rs: .... .... ..x2. .... .... .... ..x3. ....
}

pattern lift drums {
  swing = 55%
  bd: X... ..x4. .... ..x4. X... .... ..x5. ....
  sd: .... x7... .... x7... .... x7... ..x2. x7...
  ch: x4.x2. x5.x2. x4.x2. x5.x3. x4.x2. x5.x2. x4.x3. x6.x3.
  oh: .... .... ..x3. .... .... .... ..x4. ....
}

pattern breath drums {
  ch: x2... .... x3... ....
  rs: .... x3... .... x3...
}

// Each new part has its own contour rather than doubling the keyboard chord.
pattern ember-verse notes {
  step = 1/8
  gate = 46%
  . . [a3 e4] . . . [f#3 a3] . | . . [a3 c#4] . . . [b3 e4] . | . . [f#3 a3] . . . [a3 c#4] . | . . [b3 d4] . . . [a3 d4] .
  velocity: 55 . 57 . . . 43 . . . 59 . . . 45 . . . 62 . . . 46 . . . 54 . . . 41 .
}

pattern ember-chorus notes {
  step = 1/8
  gate = 44%
  . [b3 d4] . . . [d4 f#4] . . | . [a3 d4] . . . [c#4 e4] . . | . [g3 b3] . . . [b3 d4] . . | . [c#4 e4] . . . [e4 g4] . .
  velocity: 60 66 . . . 51 . . . 64 . . . 49 . . . 68 . . . 54 . . . 65 . . . 48 . .
}

pattern strings-verse {
  step = 1/4
  gate = 82%
  . . a4 - | . e5 d5 - | . . f#4 a4 | . b4 a4 -
  velocity: 60 . 66 . . 63 55 . . . 67 58 . 65 57 .
}

pattern strings-chorus {
  step = 1/4
  gate = 86%
  . d5 - b4 | . a4 - f#4 | . b4 d5 - | . c#5 b4 a4
  velocity: 70 77 . 64 . 72 . 61 . 78 65 . . 73 62 56
}

pattern strings-rise {
  step = 1/4
  gate = 88%
  . f#5 e5 d5 | . e5 d5 a4 | . g5 f#5 d5 | c#5 - b4 a4
  velocity: 70 78 64 60 . 73 63 59 . 80 67 62 75 . 62 55
}

pattern strings-bridge {
  step = 1/2
  gate = 94%
  f#4 - | a4 c#5 | b4 - | e5 c#5
  velocity: 64 . 61 55 67 . 64 54
}

pattern choir-near notes {
  step = 1/2
  gate = 93%
  [d4 f#4] - | [c#4 e4] - | [d4 f#4] - | [b3 d4] -
  velocity: 66 . 62 . 68 . 63 .
}

