  gate = 95%
  [d5 a5] - | [e5 b5] - | [a4 e5] - | [a4 e5] -
}

scene doorway {
  keys = verse-keys
  guitar = guitar-verse
  silk = verse-pad
  drums = breath
  bass = off
  answer = off
  guide = off
  danilo = off
  ember = off
  strings = off
  choir_left = choir-near
  choir_right = choir-far
}

scene verse {
  keys = verse-keys
  bass = verse-bass
  guitar = guitar-verse
  drums = pulse
  silk = off
  answer = off
  guide = off
  danilo = off
  ember = off
  strings = strings-verse
  choir_left = off
  choir_right = off
}

