  step = 1/2
  gate = 94%
  [a4 d5] - | [a4 c#5] - | [d5 f#5] - | [e5 b5] -
}

pattern coda-keys notes {
  step = 1/2
  gate = 98%
  [g2 b2 d3 f#3] - | [a2 c#3 e3 g3] - | [d3 f#3 a3 e4] - | [d3 f#3 a3 e4] -
  velocity: 69 . 65 . 77 . 51 .
}

pattern coda-strings {
  step = 1/4
  gate = 92%
  b4 a4 - . | c#5 b4 a4 - | f#4 a4 e5 - | d5 - - -
  velocity: 64 53 . . 65 54 50 . 65 54 68 . 58 . . .
}

pattern coda-choir-left notes {
  step = 1/2
  gate = 95%
  [b3 f#4] - | [c#4 g4] - | [d4 f#4] - | [d4 f#4] -
}

