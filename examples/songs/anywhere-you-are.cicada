}

automate silk.level {
  @1.1.1 -20dB @17.1.1 -15dB smooth @25.1.1 -13dB smooth @37.1.1 -19dB smooth @53.1.1 -16dB smooth @61.1.1 -12dB smooth @73.1.1 -19dB smooth @77.1.1 -26dB smooth @81.1.1 -60dB smooth
