  @1.1.1 -22dB @25.1.1 -18dB smooth @65.1.1 -16dB smooth @73.1.1 -20dB smooth @77.1.1 -27dB smooth @81.1.1 -60dB smooth
}

automate drums.level {
  @1.1.1 -18dB @5.1.1 -13dB smooth @73.1.1 -16dB smooth @81.1.1 -60dB smooth
}

// Foreground stays stable; the supporting voices bloom and retreat with the form.
automate ember.level {
  @1.1.1 -12dB @13.1.1 -5dB smooth @25.1.1 -4dB smooth @37.1.1 -11dB smooth @41.1.1 -5dB smooth @49.1.1 -3dB smooth @61.1.1 -1dB smooth @69.1.1 -4dB smooth @73.1.1 -12dB smooth @81.1.1 -60dB smooth
}

