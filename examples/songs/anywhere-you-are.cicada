  step = 1/2
  gate = 94%
  [g4 b4] - | [f#4 a4] - | [e4 g4] - | [g4 c#5] -
  velocity: 70 . 65 . 72 . 66 .
}

pattern choir-chorus-right notes {
  step = 1/2
  gate = 93%
  [d5 f#5] - | [d5 e5] - | [b4 f#5] - | [e5 f#5] -
  velocity: 63 . 58 . 66 . 60 .
}

pattern choir-bridge-left notes {
  step = 1/2
  gate = 94%
  [d4 f#4] - | [c#4 e4] - | [b3 d4] - | [c#4 g4] -
}

