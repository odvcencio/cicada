song {
  doorway*4
  verse*8
  closer*4
  lift*8
  together*12
  air*4
  verse-lit*8
  closer*4
  bridge*8
  together-wide*8
  home*4
  afterglow*4
  with-you*4
}

automate guitar.level {
  @1.1.1 -14dB @5.1.1 -9dB smooth @65.1.1 -7dB smooth @73.1.1 -12dB smooth @81.1.1 -60dB smooth
}

automate keys.level {
  @1.1.1 -10dB @5.1.1 -5.5dB smooth @17.1.1 -6dB smooth @25.1.1 -5dB smooth @37.1.1 -8dB smooth @41.1.1 -6dB smooth @61.1.1 -5dB smooth @73.1.1 -7dB smooth @77.1.1 -6dB smooth @80.3.1 -13dB smooth @81.1.1 -60dB smooth
}

