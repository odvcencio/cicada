cicada 2

title "Experimental guitar riff"

tempo 120

key e minor

seed 7

// Experimental physical string and generic amp.
// Bend uses semitones; vibrato uses cents. Both take bare numeric literals.
track lead guitar {
  level = -12dB
  experimental = on
  octave = 2
  brightness = 0.7
  pickup = 0.22
  damping = 0
  vibrato = 12
  drive = 0
}

// ~ slides into the following pitch without another pluck; - holds the gate.
pattern riff steps = 32 {
  gate = 90%
  1^ . 3 5~ | 6 - 5 . | 1 . 3 . | 5 - - - - - - - | . 1 . 3 | 5~ 6 - . | 1 - - .
}

scene clean {
  lead = riff
}

scene bend {
  lead = keep
  lead.bend = 2
  lead.vibrato = 25
}

scene muted {
  lead = riff
  lead.bend = 0
  lead.vibrato = 0
  lead.damping = 0.8
  lead.brightness = 0.45
  lead.pickup = 0.12
}

scene driven {
  lead = keep
  lead.damping = 0.15
  lead.drive = 0.7
  lead.brightness = 0.8
  lead.pickup = 0.3
}

song {
  clean
  bend
  muted
  driven
}
