}

kit articulations {
  sd = builtin.sd
  ch = builtin.ch
  cb = builtin.cb
  cy = builtin.cy
}

track kit acoustic {
  level = -12dB
}

track extra articulations {
  level = -12dB
}

pattern main drums steps=32 {
  bd: .... .... x7... .... .... .... x8... ....
  sd: .... .... x6... .... .... .... x7... ....
  ch: x3.x5. x3.x5. x3.x5. x3.x5. x3.x5. x3.x5. x3.x5. x3.x5.
  oh: .... .... .... ..x5. .... .... .... ..x5.
  rs: .... x4... .... x4... .... x4... .... x5...
  cp: .... .... .... .... x4... .... .... ....
}

pattern extra drums steps=32 {
  cy: x5... .... .... .... .... .... .... ....
}

scene groove {
  kit = main
  extra = extra
}
song { groove*4 }
