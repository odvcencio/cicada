seed 4242

kit acoustic {
  bd = builtin.bd
  sd = builtin.sd
  ch = builtin.ch
  oh = builtin.oh
  cp = builtin.cp
  rs = builtin.rs
  lt = builtin.lt
  mt = builtin.mt
