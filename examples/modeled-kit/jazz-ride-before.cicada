cicada 2
title "Jazz ride: before"
tempo 144
seed 4242

kit acoustic {
  bd = builtin.bd
  sd = builtin.sd
  ch = builtin.ch
  oh = builtin.oh
  cp = builtin.cp
  rs = builtin.rs
  lt = builtin.lt
  mt = builtin.mt
  ht = builtin.ht
  cb = builtin.cb
  cy = builtin.cy
}

kit articulations {
  sd = builtin.sd
  ch = builtin.ch
  cb = builtin.cb
  cy = builtin.cy
}

track kit acoustic {
  level = -12dB
}

track extra articulations {
  level = -12dB
}

pattern main drums steps=32 {
  bd: x2... .... .... .... x2... .... x3... ....
  sd: .... ...x2 .... x4... .... ...x2 .... x4...
  cp: .... x5... .... x5... .... x5... .... x5...
  cb: x6... x5..x4 x6... x5..x4 x6... x5..x4 x6... x5..x4
  rs: .... .... ..x3. .... .... .... ..x3. ....
}

pattern extra drums steps=32 {
  cb: .... .... .... .... x6... .... x5... ....
  cy: x4... .... .... .... .... .... .... ....
}

scene groove {
  kit = main
  extra = extra
}
song { groove*4 }
