cicada 2
title "Reggae one-drop: modeled"
tempo 76
seed 4242

kit acoustic {
  bd = model.kick
  sd = model.snare
  ch = model.hat_closed
  oh = model.hat_open
  cp = model.hat_pedal
  rs = model.cross_stick
  lt = model.tom_low
  mt = model.tom_mid
  ht = model.tom_high
  cb = model.ride_bow
  cy = model.crash
}

kit articulations {
  sd = model.rimshot
  ch = model.hat_half_open
  cb = model.ride_bell
  cy = model.splash
}

track kit acoustic {
  level = -12dB
}

track extra articulations {
  level = -12dB
}

pattern main drums steps=32 {
  bd: .... .... x7... .... .... .... x8... ....
  sd: .... .... x6... .... .... .... x7... ....
  ch: x3.x5. x3.x5. x3.x5. x3.x5. x3.x5. x3.x5. x3.x5. x3.x5.
  oh: .... .... .... ..x5. .... .... .... ..x5.
  rs: .... x4... .... x4... .... x4... .... x5...
  cp: .... .... .... .... x4... .... .... ....
}

pattern extra drums steps=32 {
  cy: x5... .... .... .... .... .... .... ....
}

scene groove {
  kit = main
  extra = extra
}
song { groove*4 }
