title "FX bus"

tempo 120

key a minor

seed 4242

fx drive drive {
  shape = soft
  gain = 9dB
  tone = 9kHz
  mix = 0.7
}

fx delay delay {
  time = 1/8T
  feedback = 0.35
  damp = 6kHz
  pingpong = true
  width = 1
  mix = 1
}

fx reverb reverb {
  size = 1
  decay = 2.4s
  damp = 8kHz
  highpass = 120Hz
  predelay = 25ms
  mix = 1
}

track bass acid {
  cutoff = 620Hz
  insert = drive
  send delay = 0.3
  send reverb = 0.35
}

track beat drums {
  send reverb = 0.2
}

pattern riff {
  1 . . . | 5 . . . | 1 . . . | 3 . . .
}

pattern beat-a drums {
  bd: X...x...X...x...
  sd: ....X.......X...
  ch: x.x.x.x.x.x.x.x.
}

scene main {
  bass = riff
  beat = beat-a
}

song {
  main*4
}
