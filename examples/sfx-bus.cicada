title "SFX sidechain"

tempo 120

key a minor

seed 4242

fx reverb reverb {
  size = 1
  decay = 1.2s
  damp = 8kHz
  highpass = 120Hz
  predelay = 15ms
  mix = 1
}

fx comp comp {
  detect = peak
  threshold = -24dB
  ratio = 4
  knee = 6dB
  attack = 5ms
  release = 150ms
  makeup = 0dB
  sidechain = sfx
  mix = 1
}

track bass acid {
  cutoff = 620Hz
}

track beat drums {
  out = sfx
  send reverb = 0.2
}

pattern riff {
  1 . . . | 5 . . . | 1 . . . | 3 . . .
}

pattern beat-a drums {
  bd: X...x...X...x...
  sd: ....X.......X...
}

scene main {
  bass = riff
  beat = beat-a
}

song {
  main*4
}

bus music {
  insert = comp
}
