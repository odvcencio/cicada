cicada 2
import "std/keys"
title "FM Bass"
tempo 108
key c major
seed 61006
track part keys.fm_bass {
  level = 0dB
  voices = 8
}
pattern comp notes {
  gate = 72%
  [c2 e2 g2 b2] . . . [d2 f2 a2 c1] . . . [g1 b1 d2 f2] . . . [c2 e2 a2 b2] . . . [a1 c2 e2 g2] . . . [d2 f2 a2 c1] . . . [g1 b1 e2 f2] . . . [c2 e2 g2 b2] . . .
}
pattern melody notes {
  gate = 78%
  e2 . g2 a2 b2 . g2 . f2 . e2 d2 c2 . . . a1 . c2 e2 g2 . e2 . d2 . f2 a2 g2 . e2 .
}
scene comping { part = comp }
scene melodic { part = melody }
song { comping*2 melodic*2 }
