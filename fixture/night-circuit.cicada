cicada 2

title "Night Circuit"

tempo 120

key a minor

seed 4242

track drums drums {
  bd_tune = 50Hz
  bd_decay = 360ms
  ch_decay = 50ms
}

track bass acid {
  cutoff = 420Hz
  reso = 0.5
  envmod = 0.5
  decay = 300ms
}

instrument glass {
  octave = 4
  param cutoff = 1600Hz
  param bite = 0.4
  voice mono {
    let osc = saw(pitch)
    let sub = square(pitch / 2)
    let tone = mix(osc, sub, 0.3)
    let shape = env(gate, 420ms)
    out = ladder(tone, cutoff * exp2(shape * 2), bite) * shape
  }
}

track keys glass {
  cutoff = 1800Hz
}

track lead acid {
  cutoff = 2400Hz
}

pattern beat drums {
  bd: x... x... x... x.x.
  sd: .... x... .... x...
  ch: x.x. x.x. x.x. x.x.
}

pattern breakfill drums {
  bd: x... .... x.x. ....
  sd: .... x... .... xxxx
  ch: x.x. x.x. x.x. ....
}

pattern pulse {
  1 . . 5 . . 1 . | 1 . 3 . 5 . 7, .
}

pattern halftime {
  1 . . . . . 5 . | . . . . 3 . . .
}

pattern progression {
  1 . 3 . 5 . 3 . | 4 . 6 . 1' . 6 .
}

pattern lift {
  5 . 7 . 2' . 7 . | 1' . 5 . 3 . 1 .
}

pattern hook {
  5 . . . 3 . . . | 1' . . . 7 . . .
}

scene intro {
  drums = beat
  bass = pulse
  keys = progression
  lead = off
}

scene drive {
  drums = beat
  bass = pulse
  keys = progression
  lead = hook
}

scene lift {
  drums = breakfill
  bass = halftime
  keys = lift
  lead = hook
}

scene out {
  drums = beat
  bass = keep
  keys = progression
  lead = off
}

song {
  intro*4 drive*4 lift*4 out*4
}
